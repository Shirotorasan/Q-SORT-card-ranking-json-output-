<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>建筑绿化偏好大挑战</title>
<!-- ============================================================
     v3.0 · ① ops 运维摘要 10 条全部灌入（中文，口径对齐论文 §2.4.2–2.4.3）
          ② 性能备注区固定显示（内容留空，正文 justify）
     左池 HGI(屋顶&阳台) | 中间 Q-sort 网格 | 右池 VGI(墙面&立面)
     全坑清零 🎉
     ============================================================ -->
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:"Microsoft YaHei",sans-serif; }
  body { background:#f0f7f4; padding:20px; }
  .screen { display:none; max-width:1200px; margin:0 auto; }
  .screen.active { display:block; }
  #sort { max-width:1400px; }
  h1 { text-align:center; margin-bottom:20px; color:#2e7d32; font-size:28px; }

  /* ===== 全尺寸卡（浏览页 / 池内展开态） ===== */
  .card-deck { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; padding:16px;
               background:#fff; border-radius:12px; box-shadow:0 4px 10px rgba(46,125,50,.1); }
  .gcard { width:240px; border:2px solid #81c784; border-radius:10px; padding:10px; background:#fff; }
  .card-title { font-weight:bold; font-size:13px; text-align:center; color:#1a3a5c;
                background:#d6e4f0; border-radius:6px; padding:6px 4px; margin-bottom:6px; line-height:1.4; }
  .card-img-placeholder { width:100%; height:110px; border-radius:6px; margin-bottom:6px;
                          display:flex; align-items:center; justify-content:center; color:#fff;
                          font-size:12px; font-weight:bold; position:relative; overflow:hidden; flex-shrink:0; }
  .card-section { font-size:11px; color:#37474f; border-radius:4px; padding:5px 7px; margin-bottom:5px; line-height:1.5; }
  .card-section.ops  { background:#eceff1; }
  .card-section.perf { background:#e3f2fd; font-style:italic; }
  .card-swot { display:flex; gap:5px; }
  .card-adv, .card-dis { flex:1; border-radius:6px; padding:6px; }
  .card-adv { background:#e8f5e9; border:1px solid #a5d6a7; }
  .card-dis { background:#ffebee; border:1px solid #ef9a9a; }
  .swot-head { font-weight:bold; font-size:11px; margin-bottom:4px; text-align:center; }
  .card-adv .swot-head { color:#1b5e20; }
  .card-dis .swot-head { color:#b71c1c; }
  .swot-line { font-size:10px; line-height:1.5; color:#333; margin-bottom:4px; }
  .group-title { margin:18px auto 10px; font-weight:bold; font-size:16px; color:#fff;
                 padding:8px 16px; border-radius:8px; }
  .group-title.hgi { background:#2e7d32; }
  .group-title.vgi { background:#00695c; }

  /* ===== 深度评价·参考面板（图左 + SWOT 右） ===== */
  .review-ref { display:flex; gap:10px; margin-bottom:14px; align-items:stretch; }
  .review-ref-img { width:210px; flex-shrink:0; border-radius:8px; position:relative; overflow:hidden;
                    display:flex; align-items:center; justify-content:center;
                    color:#fff; font-weight:bold; font-size:13px; min-height:120px; }
  .review-ref-img img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .review-ref-swot { flex:1; display:flex; gap:8px; min-width:0; }
  .review-ref-swot .swot-line { font-size:11px; }
  @media (max-width:700px){
    .review-ref { flex-direction:column; }
    .review-ref-img { width:100%; height:150px; }
  }

  /* ===== 三栏排序布局 ===== */
  .sort-layout { display:flex; gap:14px; align-items:flex-start; }
  .side-pool { width:262px; flex-shrink:0; border-radius:12px; padding:8px; transition:background .15s; }
  .side-pool.drag-over { background:#e8f5e9; outline:2px dashed #2e7d32; }
  .grid-center { flex:1; min-width:0; }
  .pool-title { display:flex; justify-content:space-between; align-items:center;
                font-weight:bold; padding:8px 10px; border-radius:8px; color:#fff;
                margin-bottom:10px; font-size:14px; }
  .pool-title.hgi { background:#2e7d32; }
  .pool-title.vgi { background:#00695c; }
  .pool-toggle { background:rgba(255,255,255,.25); border:none; color:#fff; font-size:11px;
                 padding:4px 10px; border-radius:12px; cursor:pointer; }
  .pool-toggle:hover { background:rgba(255,255,255,.4); }
  .pool-cards { display:flex; flex-direction:column; gap:10px; }
  .empty-pool { color:#9e9e9e; text-align:center; font-size:12px; padding:18px 0; }

  /* 池内缩略卡 */
  .pcard { border:2px solid #81c784; border-radius:10px; background:#fff; padding:8px;
           cursor:grab; user-select:none; transition:box-shadow .15s, transform .15s;
           position:relative; }
  .pcard:hover { transform:translateY(-2px); box-shadow:0 4px 10px rgba(46,125,50,.18); }
  .pcard.dragging { opacity:.4; transform:rotate(4deg); }
  .pcard.expanded { border-color:#2e7d32; background:#fbfff8; }
  .pcard-head { display:flex; gap:8px; align-items:flex-start; }
  .pcard-thumb { width:52px; height:52px; border-radius:6px; flex-shrink:0;
                 display:flex; align-items:center; justify-content:center;
                 color:#fff; font-weight:bold; font-size:11px; position:relative; overflow:hidden; }
  .pcard-body { flex:1; min-width:0; }
  .pcard-name { font-size:12px; font-weight:bold; line-height:1.3; margin-bottom:4px; color:#222; }
  .pcard-sum { font-size:10px; color:#444; line-height:1.45; margin-bottom:2px; }
  .mini { margin-right:3px; }
  .mini.plus { color:#2e7d32; }
  .mini.minus { color:#d84315; }
  .pcard-detail { display:none; margin-top:8px; border-top:1px dashed #c8e6c9; padding-top:8px; }
  .pcard.expanded .pcard-detail { display:block; }

  /* ===== 悬停浮动预览 ===== */
  @media (hover:hover) and (min-width:1101px) {
    .pcard:not(.expanded) .pcard-detail {
      display:block;
      position:absolute;
      top:-6px;
      width:266px;
      padding:8px;
      background:#fff;
      border:2px solid #2e7d32;
      border-radius:12px;
      box-shadow:0 10px 28px rgba(0,0,0,.28);
      z-index:1500;
      left:calc(100% + 8px);
      max-height:calc(100vh - 40px);
      overflow-y:auto;
      visibility:hidden;
      opacity:0;
      transition:opacity .12s ease .28s, visibility 0s linear .28s;
    }
    #poolVGI .pcard:not(.expanded) .pcard-detail { left:auto; right:calc(100% + 8px); }
    .pcard:not(.expanded):hover .pcard-detail { visibility:visible; opacity:1; }
    .pcard.dragging .pcard-detail { visibility:hidden !important; opacity:0 !important; }
  }

  /* 槽内超紧凑卡 */
  .scard { width:100%; background:#fff; border-radius:8px; padding:5px;
           display:flex; gap:7px; align-items:center; cursor:grab; user-select:none; }
  .scard:hover { box-shadow:0 2px 8px rgba(0,0,0,.15); }
  .scard.dragging { opacity:.4; }
  .scard-thumb { width:44px; height:44px; border-radius:6px; flex-shrink:0;
                 display:flex; align-items:center; justify-content:center;
                 color:#fff; font-size:10px; font-weight:bold; position:relative; overflow:hidden; }
  .scard-name { font-size:11px; font-weight:bold; line-height:1.3; color:#222; }

  /* 图片统一加载规则：图浮在色块上，挂了自动露出色块 */
  .card-img-placeholder img, .pcard-thumb img, .scard-thumb img {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  /* ===== Q-sort 网格 ===== */
  .grid-row { display:flex; gap:12px; justify-content:center; }
  .col { flex:1; max-width:190px; background:#fff; border-radius:12px; padding:8px;
         text-align:center; box-shadow:0 2px 8px rgba(0,0,0,.08); }
  .col h3 { font-size:14px; padding:7px 0; border-radius:8px; color:#fff; margin-bottom:8px; }
  .col.strong-disagree h3 { background:#d84315; }
  .col.disagree h3 { background:#ff7043; }
  .col.neutral h3 { background:#9e9e9e; }
  .col.agree h3 { background:#66bb6a; }
  .col.strong-agree h3 { background:#2e7d32; }
  .slots { display:flex; flex-direction:column; gap:8px; }
  .slot { min-height:60px; border:2px dashed #c8e6c9; border-radius:8px;
          display:flex; align-items:center; justify-content:center; padding:2px; }
  .slot.filled { border-style:solid; border-color:#81c784; }
  .slot.drag-over { border-color:#2e7d32; background:#e8f5e9; transform:scale(1.03); }
  .slot-label { font-size:11px; color:#bbb; }

  /* ===== 拖动提示条 ===== */
  #dragHint { position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
              background:#2e7d32; color:#fff; padding:10px 24px; border-radius:25px;
              display:none; z-index:2000; box-shadow:0 4px 12px rgba(0,0,0,.3); font-size:14px; }
  body.dragging-active #dragHint { display:block; }

  /* ===== 按钮 / 通用 ===== */
  .btn { display:inline-block; padding:12px 36px; font-size:16px; background:#2e7d32; color:#fff;
         border:none; border-radius:25px; cursor:pointer; margin:8px; transition:all .2s; }
  .btn:hover { background:#1b5e20; transform:translateY(-2px); }
  .btn.secondary { background:#78909c; }
  .btn.secondary:hover { background:#546e7a; }
  .btn.small { padding:6px 14px; font-size:12px; margin:0; border-radius:15px; }
  .btn:disabled { background:#aaa; cursor:not-allowed; transform:none; }
  .info { text-align:center; margin:12px 0; color:#555; }
  .warn { color:#d84315; font-weight:bold; }
  #timer { font-size:32px; text-align:center; color:#d84315; margin:10px 0; font-weight:bold; }

  /* ===== 首页 ===== */
  .setup-box { background:#fff; padding:40px; border-radius:16px; max-width:600px; margin:0 auto;
               box-shadow:0 4px 12px rgba(46,125,50,.15); text-align:center; }
  .setup-box label { display:block; margin:12px 0 6px; font-weight:bold; color:#333; }
  .setup-box input { width:100%; padding:12px; border:2px solid #c8e6c9; border-radius:8px;
                     font-size:14px; margin-bottom:20px; text-align:center; }
  .setup-box input:focus { outline:none; border-color:#2e7d32; }
  .choice-group { display:flex; flex-direction:column; gap:12px; }
  .choice-btn { width:100%; padding:20px; border:2px solid #c8e6c9; background:#f9fbe7; border-radius:12px;
                cursor:pointer; text-align:left; transition:all .2s; }
  .choice-btn:hover { border-color:#2e7d32; background:#e8f5e9; transform:translateY(-2px); }
  .choice-btn b { font-size:16px; color:#2e7d32; display:block; margin-bottom:6px; }
  .choice-btn span { font-size:12px; color:#666; }

  /* ===== 评价页 ===== */
  .review-block { background:#fff; padding:20px; border-radius:12px; margin-bottom:20px;
                  box-shadow:0 4px 10px rgba(0,0,0,.05); border-left:5px solid #2e7d32; }
  .input-row { display:flex; gap:8px; margin-bottom:8px; align-items:center; }
  .input-row input { flex:1; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:14px; }
  .input-row input:focus { outline:none; border-color:#66bb6a; }
  .btn-del { background:#ffebee; color:#d84315; border:1px solid #ffcdd2; border-radius:8px;
             padding:6px 10px; cursor:pointer; font-weight:bold; }
  .btn-del:hover { background:#d84315; color:#fff; }
  .section-title-pros { color:#1b5e20; text-align:left; margin-top:16px; border-bottom:2px solid #a5d6a7;
                        padding-bottom:4px; font-weight:bold; }
  .section-title-cons { color:#d84315; text-align:left; margin-top:20px; border-bottom:2px solid #ffccbc;
                        padding-bottom:4px; font-weight:bold; }
  .check-icon { width:24px; text-align:center; font-weight:bold; font-size:18px; }
  .check-icon.valid { color:#2e7d32; }
  .check-icon.invalid { color:#d84315; }
  .check-panel { position:fixed; right:20px; top:20px; width:260px; background:#fff; padding:15px;
                 border-radius:12px; box-shadow:0 6px 16px rgba(0,0,0,.12); z-index:1000;
                 display:none; border:2px solid #c8e6c9; }
  .check-panel h4 { margin-bottom:10px; color:#2e7d32; border-bottom:1px solid #c8e6c9; padding-bottom:8px; }
  .check-item { display:flex; justify-content:space-between; margin-bottom:6px; font-size:13px; align-items:center; }
  .check-status { font-weight:bold; }

  table.summary { width:100%; border-collapse:collapse; background:#fff; margin-top:16px;
                  border-radius:8px; overflow:hidden; }
  table.summary th, table.summary td { border:1px solid #c8e6c9; padding:10px; text-align:center; font-size:13px; }
  table.summary th { background:#2e7d32; color:#fff; }

  @media (max-width:1400px){ .side-pool { width:225px; } }
  @media (max-width:1100px){
    .sort-layout { flex-direction:column; }
    .side-pool { width:100%; }
    .pool-cards { flex-direction:row; flex-wrap:wrap; justify-content:center; }
    .pcard { width:240px; }
  }
</style>
</head>
<body>

<div id="dragHint">🖐 松手即可把卡片放回池子（显示全部内容）</div>

<!-- 右侧检查面板 -->
<div id="checkPanel" class="check-panel">
  <h4>📋 填写检查 (建议 ≥ 15字)</h4>
  <div id="checkList"></div>
  <div style="margin-top:10px; font-size:12px; color:#666;">全部显示 <span style="color:#2e7d32;font-weight:bold;">✓ 合格</span> 提交体验最佳。</div>
</div>

<!-- 屏幕1：设置 -->
<div id="setup" class="screen active">
  <h1>🌿 对我最爱的建筑绿化卡片排序大挑战 🏢</h1>
  <div class="setup-box">
    <label>你的专属代号 (如 R1, E2)</label>
    <input type="text" id="pid" placeholder="请输入代号">
    <label>请选择你当前的挑战状态：</label>
    <div class="choice-group">
      <button class="choice-btn" onclick="startSort('preT1')">
        <b>🌱 我是新手：第一次做这个挑战</b>
        <span>在不受他人影响的情况下，凭直觉选出你最真实的偏好。</span>
      </button>
      <button class="choice-btn" onclick="startSort('preT2')">
        <b>👀 我是高手：已看过其他组的答案，来做第二次</b>
        <span>请根据观摩后的最新想法重新排序 (限时5分钟)。</span>
      </button>
    </div>
    <p class="info" style="margin-top:14px; font-size:12px; color:#888;">
      规则提示：每列槽位固定(强烈反对1张、反对2张、中立4张、赞成2张、强烈赞成1张)。<br>
      槽满后无法再放入，<b>必须做出取舍</b>——这就是挑战的乐趣所在！
    </p>
  </div>
</div>

<!-- 屏幕2：浏览 -->
<div id="browse" class="screen">
  <h1>先看卡：10 个绿化原型</h1>
  <p class="info">卡片分成了两大类，先花点时间浏览，心里有数后开始大挑战！</p>
  <div class="group-title hgi">🏠 屋顶 & 阳台绿化</div>
  <div class="card-deck" id="browseHGI"></div>
  <div class="group-title vgi">🧗 墙面 & 立面绿化</div>
  <div class="card-deck" id="browseVGI"></div>
  <div style="text-align:center; margin-top:20px;">
    <button class="btn" onclick="renderSort(); show('sort');">我已了解，开始排序 🚀</button>
  </div>
</div>

<!-- 屏幕3：排序 -->
<div id="sort" class="screen">
  <h1 id="sortTitle">把卡片拖入网格</h1>
  <div id="timer"></div>
  <p class="info">未放置: <span id="remaining" class="warn">10</span> 张 ·
     <span style="color:#888">拖入网格排序 · 拖到任意空白处松手可放回池子 · 槽位间可直接互拖 ·
     <b style="color:#2e7d32">鼠标悬停两侧卡片即可预览完整信息</b></span></p>
  <div class="sort-layout">
    <div class="side-pool" id="poolHGI">
      <div class="pool-title hgi"><span>🏠 屋顶 & 阳台绿化</span>
        <button class="pool-toggle" id="poolBtnHGI" onclick="togglePool('HGI')">⤢ 展开全部</button></div>
      <div class="pool-cards" id="poolCardsHGI"></div>
    </div>
    <div class="grid-center"><div class="grid-row" id="grid"></div></div>
    <div class="side-pool" id="poolVGI">
      <div class="pool-title vgi"><span>🧗 墙面 & 立面绿化</span>
        <button class="pool-toggle" id="poolBtnVGI" onclick="togglePool('VGI')">⤡ 收起全部</button></div>
      <div class="pool-cards" id="poolCardsVGI"></div>
    </div>
  </div>
  <div style="text-align:center; margin-top:20px;">
    <button class="btn" id="submitBtn" onclick="proceedToReview()" disabled>下一步：深度评价 📝</button>
    <button class="btn secondary" onclick="resetSort()">重新开始 🔄</button>
  </div>
</div>

<!-- 屏幕4：评价 -->
<div id="review" class="screen">
  <h1>📝 深度评价</h1>
  <p class="info">太棒了！现在请针对你排在 <b>强烈赞成</b> 和 <b>赞成</b> 的选项，写下具体的正反面意见。<br>每张卡上方附有<b>图片与正反面参考</b>，帮助你回忆。默认各 3 条，每条 <b>建议至少 15 个字</b>。可点击右侧 <b>−</b> 删除或底部 <b>+</b> 增加。</p>
  <div id="reviewArea"></div>
  <div style="text-align:center; margin-top:20px;">
    <button class="btn" onclick="finalSubmit()">提交全部结果 🎉</button>
  </div>
</div>

<!-- 屏幕5：完成 -->
<div id="done" class="screen">
  <h1>🎉 挑战完成！</h1>
  <p class="info">你的选择与意见已生成。点击下载按钮，然后<b>把文件发到微信群</b>即可。</p>
  <div style="text-align:center"><button class="btn" onclick="downloadJSON()">下载我的结果 ⬇️</button></div>
  <div id="resultPreview"></div>
</div>

<!-- 屏幕6：汇总 -->
<div id="aggregate" class="screen">
  <h1>📊 汇总矩阵 (主持人用)</h1>
  <p class="info">把收到的所有 JSON 文件一起拖到下面的框里。</p>
  <div id="dropzone" style="border:3px dashed #2e7d32; border-radius:12px; padding:40px;
       text-align:center; color:#2e7d32; font-size:16px; background:#f9fbe7;">
    拖拽 JSON 文件到此处
  </div>
  <div id="matrixWrap"></div>
  <button class="btn secondary" style="display:none" id="csvBtn" onclick="exportCSV()">导出 CSV</button>
</div>

<script>
/* ================= 卡片数据 ================= */
const CARDS = [
 {id:"EGR", name:"轻型绿色屋顶 Extensive Green Roof",
  s:"非常轻——相当于每平方米屋顶只站一两个成人的重量；酷热午后，屋顶表面可凉快 8–14 °C。",
  w:"栽培基质只有几厘米厚，只有强韧耐旱的植物能存活；一旦彻底干透，屋顶反而可能比光秃秃的混凝土更热。",
  o:"屋顶是全楼共享的，一个决定即可惠及所有住户；现时资助计划优先考虑 2000 年前落成的屋邨。",
  t:"常用的耐旱植物在潮湿夏季可能烂根；闷热夜晚，白天蓄积的热量可能倒灌进室内。",
  sEn:"Very light — like one or two adults standing on each square metre of roof, so hot afternoons the roof surface can feel 8–14 °C cooler",
  wEn:"The culture is only a few centimetres deep, so only tough plants survive; fully dried out, the roof can get hotter than bare concrete",
  oEn:"The roof is shared, so one decision covers everyone; funding currently prioritises estates built before 2000",
  tEn:"The usual drought-loving plants can rot in our humid summers: on muggy nights, stored heat can leak back indoors",
  img:"img/EGR.png", ops:"屋顶设 2.5–15 厘米浅层种植床，栽植景天与苔藓；养护极少", perf:""},
 {id:"SIGR", name:"半密集绿色屋顶 Semi-Intensive Green Roof",
  s:"折中选择：土壤稍深、植物种类更丰富，顶楼室内天花板温度约低 5 °C。",
  w:"比轻型系统重，需要专门设计的排水层；在潮湿的南方气候中几乎未经实测。",
  o:"当轻型屋顶显得太单调、完整花园又太费工时，它是恰到好处的折中方案。",
  t:"排水不良的土壤会积水，同时伤害植物与楼板。",
  sEn:"A middle option: slightly deeper soil, more plant variety, and top-floor ceilings about 5 °C cooler",
  wEn:"Heavier than a thin system and needs a designed drainage layer; barely tested in humid southern climates",
