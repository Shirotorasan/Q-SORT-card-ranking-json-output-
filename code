/* 色块占位色池（图片加载失败时兜底用） */
const COLORS = { EGR:"#66bb6a", SIGR:"#43a047", IGR:"#2e7d32", RTF:"#1b5e20",
                 GB:"#8bc34a", GFD:"#00897b", GFI:"#00695c", LWC:"#26a69a",
                 LWM:"#00838f", VFS:"#006064" };

/* 分组：HGI = 屋顶&阳台（左池），其余为 VGI（右池） */
const HGI = ["EGR","SIGR","IGR","RTF","GB"];

const SLOTS = [
 {key:"-2", label:"强烈反对", cap:1, cls:"strong-disagree"},
 {key:"-1", label:"反对",     cap:2, cls:"disagree"},
 {key:"0",  label:"中立",     cap:4, cls:"neutral"},
 {key:"+1", label:"赞成",     cap:2, cls:"agree"},
 {key:"+2", label:"强烈赞成", cap:1, cls:"strong-agree"}
];

const MIN_LEN = 15;
let state = { pid:"", mode:"", placement:{}, startTime:0, log:[], feedback:{} };
let expandedIds = new Set();
let justDragged = false;
let hasConfirmedShortText = false;
let timerInterval = null;

/* ================= 通用 ================= */
function show(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.getElementById('checkPanel').style.display = (id === 'review') ? 'block' : 'none';
  window.scrollTo(0,0);
}

function startSort(selectedMode){
  if(timerInterval){ clearInterval(timerInterval); timerInterval=null; }
  const pid = document.getElementById('pid').value.trim();
  if(!pid){ alert("请先输入你的专属代号哦！"); return; }
  state.pid = pid;
  state.mode = selectedMode;
  state.placement = {};
  state.feedback = {};
  state.startTime = Date.now();
  state.log = [{event:"session_start", pid, mode:state.mode, ts:new Date().toISOString()}];
  renderBrowse();
  show('browse');
}

/* ================= 图片块（图挂了自动露出底下的色块+ID） ================= */
function imgBlock(c, cls, label){
  return `<div class="${cls}" style="background:${COLORS[c.id]||'#90a4ae'}">${label}${c.img?`<img src="${c.img}" alt="" onerror="this.remove()">`:''}</div>`;
}

/* ================= 卡片渲染 ================= */
function cardHTML(c, draggable=true){
  const imgHTML = imgBlock(c, 'card-img-placeholder', c.id + ' · 效果示意图');
  const opsHTML  = `<div class="card-section ops">🔧 运维摘要：${c.ops}</div>`;
  /* 性能备注区固定显示；perf 有内容时自动接在冒号后 */
  const perfHTML = `<div class="card-section perf"><b>📊 性能备注区</b>${c.perf ? `：${c.perf}` : ''}</div>`;
  return `<div class="gcard" data-card="${c.id}" ${draggable?'draggable="true"':''}>
    <div class="card-title">${c.name}</div>
    ${imgHTML}
    ${opsHTML}
    ${perfHTML}
    <div class="card-swot">
      <div class="card-adv">
        <div class="swot-head">✓ 优点</div>
        <div class="swot-line">${c.s}</div>
        <div class="swot-line">${c.o}</div>
      </div>
      <div class="card-dis">
        <div class="swot-head">✗ 缺点</div>
        <div class="swot-line">${c.w}</div>
        <div class="swot-line">${c.t}</div>
      </div>
    </div>
  </div>`;
}

/* 池内缩略卡 */
function poolCardHTML(c){
  const thumb = imgBlock(c, 'pcard-thumb', c.id);
  return `<div class="pcard ${expandedIds.has(c.id)?'expanded':''}" data-card="${c.id}"
            draggable="true" onclick="toggleExpand('${c.id}')">
    <div class="pcard-head">
      ${thumb}
      <div class="pcard-body">
        <div class="pcard-name">${c.name}</div>
        <div class="pcard-sum"><b class="mini plus">✓</b>${firstClause(c.s)}</div>
        <div class="pcard-sum"><b class="mini minus">✗</b>${firstClause(c.w)}</div>
      </div>
    </div>
    <div class="pcard-detail">${cardHTML(c,false)}</div>
  </div>`;
}
function firstClause(str, n=26){
  const s = String(str).split(/[；;。]/)[0];
  return s.length > n ? s.slice(0, n) + "…" : s;
}
function toggleExpand(id){
  if(justDragged) return;
  if(expandedIds.has(id)) expandedIds.delete(id); else expandedIds.add(id);
  renderSort();
}
function togglePool(side){
  const ids = CARDS.filter(c => side==='HGI' ? HGI.includes(c.id) : !HGI.includes(c.id)).map(c=>c.id);
  const allOpen = ids.every(id=>expandedIds.has(id));
  ids.forEach(id => allOpen ? expandedIds.delete(id) : expandedIds.add(id));
  renderSort();
  document.getElementById(side==='HGI'?'poolBtnHGI':'poolBtnVGI').textContent =
    allOpen ? '⤢ 展开全部' : '⤡ 收起全部';
}

/* 槽内超紧凑卡 */
function slotCardHTML(c){
  const thumb = imgBlock(c, 'scard-thumb', c.id);
  return `<div class="scard" data-card="${c.id}" draggable="true">
    ${thumb}<div class="scard-name">${c.name}</div>
  </div>`;
}

function renderBrowse(){
  const hgi = CARDS.filter(c=>HGI.includes(c.id));
  const vgi = CARDS.filter(c=>!HGI.includes(c.id));
  document.getElementById('browseHGI').innerHTML = hgi.map(c=>cardHTML(c,false)).join('');
  document.getElementById('browseVGI').innerHTML = vgi.map(c=>cardHTML(c,false)).join('');
}

/* ================= 排序 ================= */
function renderSort(){
  if(state.mode === 'preT1') {
    document.getElementById('sortTitle').innerHTML = "💡 请凭第一直觉，将卡片拖入中间网格";
  } else {
    document.getElementById('sortTitle').innerHTML =
      "⏳ 观摩后的二次重排大挑战！(限时5分钟)<br><span style='font-size:14px; color:#d84315; font-weight:normal;'>请基于刚才观摩他人画布后的最新想法，独立完成重新排序</span>";
  }
  const placed = new Set(Object.keys(state.placement));
  const free = CARDS.filter(c=>!placed.has(c.id));
  const hgi  = free.filter(c=>HGI.includes(c.id));
  const vgi  = free.filter(c=>!HGI.includes(c.id));
  document.getElementById('poolCardsHGI').innerHTML =
    hgi.length ? hgi.map(poolCardHTML).join('') : '<p class="empty-pool">✅ 全部已放置</p>';
  document.getElementById('poolCardsVGI').innerHTML =
    vgi.length ? vgi.map(poolCardHTML).join('') : '<p class="empty-pool">✅ 全部已放置</p>';
  const grid = document.getElementById('grid');
  grid.innerHTML = SLOTS.map(s=>{
    const inCol = Object.entries(state.placement).filter(([id,col])=>col===s.key).map(([id])=>id);
    let slotsHTML = '';
    for(let i=0;i<s.cap;i++){
      const c = inCol[i] ? CARDS.find(x=>x.id===inCol[i]) : null;
      slotsHTML += `<div class="slot ${c?'filled':''}" data-col="${s.key}">
        ${c ? slotCardHTML(c) : `<span class="slot-label">空位</span>`}
      </div>`;
    }
    return `<div class="col ${s.cls}"><h3>${s.label}（${s.key}）</h3><div class="slots">${slotsHTML}</div></div>`;
  }).join('');
  document.getElementById('remaining').textContent = free.length;
  document.getElementById('submitBtn').disabled = free.length > 0;
  bindSlotDnD();
}

function bindSlotDnD(){
  document.querySelectorAll('.pcard[draggable], .scard[draggable]').forEach(el=>{
    el.addEventListener('dragstart', e=>{
      e.dataTransfer.setData('card', el.dataset.card);
      el.classList.add('dragging');
      document.body.classList.add('dragging-active');
    });
    el.addEventListener('dragend', ()=>{
      el.classList.remove('dragging');
      document.body.classList.remove('dragging-active');
      justDragged = true; setTimeout(()=>justDragged=false, 80);
    });
  });
  document.querySelectorAll('.slot').forEach(slot=>{
    slot.addEventListener('dragover', e=>{
      e.preventDefault(); e.stopPropagation();
      const col = SLOTS.find(s=>s.key===slot.dataset.col);
      const count = Object.values(state.placement).filter(v=>v===col.key).length;
      if(count < col.cap) slot.classList.add('drag-over');
    });
    slot.addEventListener('dragleave', ()=>slot.classList.remove('drag-over'));
    slot.addEventListener('drop', e=>{
      e.preventDefault(); e.stopPropagation();
      slot.classList.remove('drag-over');
      const cardId = e.dataTransfer.getData('card');
      if(!cardId) return;
      const col = SLOTS.find(s=>s.key===slot.dataset.col);
      const count = Object.values(state.placement).filter(v=>v===col.key).length;
      if(count >= col.cap){
        alert(`「${col.label}」列只能放 ${col.cap} 张，已经满啦！请重新权衡一下~`);
        return;
      }
      state.log.push({event:"place", card:cardId, from:state.placement[cardId]||"pool", to:col.key, ts:new Date().toISOString()});
      state.placement[cardId] = col.key;
      renderSort();
    });
  });
}

/* 侧池与空白处的 drop 监听 */
(function initDnD(){
  document.querySelectorAll('.side-pool').forEach(pool=>{
    pool.addEventListener('dragover', e=>{ e.preventDefault(); e.stopPropagation(); pool.classList.add('drag-over'); });
    pool.addEventListener('dragleave', ()=>pool.classList.remove('drag-over'));
    pool.addEventListener('drop', e=>{
      e.preventDefault(); e.stopPropagation();
      pool.classList.remove('drag-over');
      returnToPool(e);
    });
  });
  document.addEventListener('dragover', e=>e.preventDefault());
  document.addEventListener('drop', e=>{
    e.preventDefault();
    returnToPool(e);
  });
})();

function returnToPool(e){
  const cardId = e.dataTransfer.getData('card');
  if(!cardId) return;
  if(state.placement[cardId]){
    state.log.push({event:"remove", card:cardId, from:state.placement[cardId], to:"pool", ts:new Date().toISOString()});
    delete state.placement[cardId];
  }
  expandedIds.add(cardId);
  renderSort();
}

/* ================= preT2 计时 ================= */
function startTimerIfPreT2(){
  if(state.mode !== 'preT2') return;
  let remain = 300;
  timerInterval = setInterval(()=>{
    const m = Math.floor(remain/60), s = remain%60;
    document.getElementById('timer').textContent = `⏱ ${m}:${String(s).padStart(2,'0')}`;
    if(--remain < 0){
      clearInterval(timerInterval);
      if(Object.keys(state.placement).length === CARDS.length){
        alert("时间到！自动进入评价环节。");
        proceedToReview();
      } else {
        alert("时间到。请立即完成剩余放置后进入下一步。");
      }
    }
  }, 1000);
}
const origShow = show;
show = function(id){
  if(id==='sort' && !timerInterval) startTimerIfPreT2();
  origShow(id);
};

function proceedToReview() {
  const placed = Object.keys(state.placement).length;
  if(placed < CARDS.length){
    if(!confirm(`还有 ${CARDS.length-placed} 张未放置，确认进入评价？未放置的将被记为缺失。`)) return;
  }
  state.log.push({event:"enter_review", ts:new Date().toISOString()});
  if(timerInterval){ clearInterval(timerInterval); timerInterval=null; }
  document.getElementById('timer').textContent = '';
  renderReview();
  show('review');
}

