    html += `
      <div class="review-block" id="review_block_${id}">
        <div class="card-title" style="font-size:14px;">${c.name} · 你的排位：${rankLabel}</div>
        ${refPanel}
        <div class="section-title-pros">优势 / 支持原因 (建议≥15字)</div>
        <div id="pros_${id}">
          ${[0,1,2].map(i => `
            <div class="input-row">
              <input type="text" class="fb-input pros" data-card="${id}" data-type="pros" placeholder="写下你支持它的第 ${i+1} 个原因..." oninput="checkInput(this)">
              <span class="check-icon invalid" id="check_${id}_pros_${i}">✗</span>
              <button class="btn-del" onclick="removeInput(this)">−</button>
            </div>`).join('')}
        </div>
        <button class="btn secondary small" onclick="addInput('${id}', 'pros')">+ 添加优势</button>
        <div class="section-title-cons">劣势 / 顾虑原因 (建议≥15字)</div>
        <div id="cons_${id}">
          ${[0,1,2].map(i => `
            <div class="input-row">
              <input type="text" class="fb-input cons" data-card="${id}" data-type="cons" placeholder="写下你反对它的第 ${i+1} 个原因..." oninput="checkInput(this)">
              <span class="check-icon invalid" id="check_${id}_cons_${i}">✗</span>
              <button class="btn-del" onclick="removeInput(this)">−</button>
            </div>`).join('')}
        </div>
        <button class="btn secondary small" onclick="addInput('${id}', 'cons')">+ 添加劣势</button>
      </div>`;
  });
  document.getElementById('reviewArea').innerHTML = html;
  updateCheckPanel();
}

function addInput(cardId, type) {
  const container = document.getElementById(`${type}_${cardId}`);
  const idx = container.children.length;
  const div = document.createElement('div');
  div.className = 'input-row';
  div.innerHTML = `
    <input type="text" class="fb-input ${type}" data-card="${cardId}" data-type="${type}" placeholder="继续写原因..." oninput="checkInput(this)">
    <span class="check-icon invalid" id="check_${cardId}_${type}_${idx}">✗</span>
    <button class="btn-del" onclick="removeInput(this)">−</button>`;
  container.appendChild(div);
  updateCheckPanel();
}

function removeInput(btn) {
  const container = btn.parentElement.parentElement;
  if(container.children.length > 1) {
    btn.parentElement.remove();
    updateCheckPanel();
  } else {
    alert("至少保留一条，可以留空哦~");
  }
}

function checkInput(inputElement) {
  const checkSpan = inputElement.nextElementSibling;
  if(inputElement.value.trim().length >= MIN_LEN) {
    checkSpan.textContent = '✓';
    checkSpan.classList.replace('invalid','valid');
  } else {
    checkSpan.textContent = '✗';
    checkSpan.classList.replace('valid','invalid');
  }
  hasConfirmedShortText = false;
  updateCheckPanel();
}

function updateCheckPanel() {
  const topKIds = Object.entries(state.placement)
    .filter(([id, col]) => col === '+2' || col === '+1')
    .map(([id]) => id);
  let panelHtml = '';
  topKIds.forEach(id => {
    const c = CARDS.find(x=>x.id===id);
    const pros = document.querySelectorAll(`.fb-input.pros[data-card="${id}"]`);
    const cons = document.querySelectorAll(`.fb-input.cons[data-card="${id}"]`);
    let pv=0; pros.forEach(i=>{ if(i.value.trim().length>=MIN_LEN) pv++; });
    let cv=0; cons.forEach(i=>{ if(i.value.trim().length>=MIN_LEN) cv++; });
    panelHtml += `
      <div class="check-item"><span><b>${c.id}</b> 优势</span>
        <span class="check-status" style="color:${pv===pros.length?'#2e7d32':'#d84315'}">${pv===pros.length?'✓ 合格':`${pv}/${pros.length}`}</span></div>
      <div class="check-item"><span><b>${c.id}</b> 劣势</span>
        <span class="check-status" style="color:${cv===cons.length?'#2e7d32':'#d84315'}">${cv===cons.length?'✓ 合格':`${cv}/${cons.length}`}</span></div>`;
  });
  document.getElementById('checkList').innerHTML = panelHtml || '<div>无评价项</div>';
}

/* ================= 提交 ================= */
function finalSubmit(){
  let invalidCount = 0, invalidItems = [];
  document.querySelectorAll('.fb-input').forEach(input => {
    if(input.value.trim().length < MIN_LEN) {
      invalidCount++;
      if(input.value.trim().length > 0) invalidItems.push(input.value.trim());
    }
  });
  if(invalidCount > 0 && !hasConfirmedShortText) {
    const confirmMsg = `检测到 ${invalidCount} 条意见输入少于 15 字或为空。\n\n我们理解简短的文字可能已足以表达您的真实想法。请确认：您输入的这些短句或留空，是否准确反映了您的意思？\n\n点击"确定"将以此提交，点击"取消"返回修改。`;
    if(confirm(confirmMsg)) {
      hasConfirmedShortText = true;
      state.log.push({event:"short_text_confirmed", count: invalidCount, items: invalidItems, ts:new Date().toISOString()});
    } else {
      return;
    }
  }
  state.feedback = {};
  document.querySelectorAll('.fb-input').forEach(input => {
    const card = input.dataset.card, type = input.dataset.type;
    if(!state.feedback[card]) state.feedback[card] = {pros:[], cons:[]};
    state.feedback[card][type].push(input.value.trim());
  });
  state.log.push({event:"final_submit", ts:new Date().toISOString()});
  window.__result = {
    participant: state.pid,
    mode: state.mode,
    startedAt: new Date(state.startTime).toISOString(),
    submittedAt: new Date().toISOString(),
    durationSec: Math.round((Date.now()-state.startTime)/1000),
    placement: state.placement,
    feedback: state.feedback,
    actionLog: state.log
  };
  const rows = SLOTS.map(s=>{
    const ids = Object.entries(state.placement).filter(([id,c])=>c===s.key).map(([id])=>id);
    return `<tr><td><b>${s.label}</b>（${s.key}）</td><td>${ids.join(', ')||'—'}</td></tr>`;
  }).join('');
  document.getElementById('resultPreview').innerHTML =
    `<table class="summary" style="margin-top:20px"><tr><th>列</th><th>卡片</th></tr>${rows}</table>`;
  show('done');
}

function downloadJSON(){
  const blob = new Blob([JSON.stringify(window.__result,null,2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `qsort_${state.pid}_${state.mode}_${Date.now()}.json`;
  a.click();
}

function resetSort(){
  if(timerInterval){ clearInterval(timerInterval); timerInterval=null; }
  state.placement = {};
  state.feedback = {};
  expandedIds.clear();
  state.log = [{event:"reset", ts:new Date().toISOString()}];
  renderSort();
}

/* ================= 汇总 ================= */
const allResults = [];
let csvData = "";
const dz = document.getElementById('dropzone');
dz.addEventListener('dragover', e=>e.preventDefault());
dz.addEventListener('drop', e=>{
  e.preventDefault();
  [...e.dataTransfer.files].forEach(f=>{
    const r = new FileReader();
    r.onload = ev=>{
      try{
        allResults.push(JSON.parse(ev.target.result));
        renderMatrix();
      }catch(err){ alert(`${f.name} 不是有效 JSON`); }
    };
    r.readAsText(f);
  });
});

function renderMatrix(){
  let html = `<table class="summary"><tr><th>参与者</th><th>模式</th>`;
  CARDS.forEach(c=>html+=`<th>${c.id}</th>`);
  html += `<th>用时(s)</th></tr>`;
  allResults.forEach(r=>{
    html += `<tr><td>${r.participant}</td><td>${r.mode}</td>`;
    CARDS.forEach(c=>html+=`<td>${r.placement[c.id]??'?'}</td>`);
    html += `<td>${r.durationSec}</td></tr>`;
  });
  html += `</table>`;
  document.getElementById('matrixWrap').innerHTML = html;
  document.getElementById('csvBtn').style.display='inline-block';
  let csv = "participant,mode," + CARDS.map(c=>c.id).join(",") + ",durationSec\n";
  allResults.forEach(r=>{
    csv += `${r.participant},${r.mode},` + CARDS.map(c=>r.placement[c.id]??"").join(",") + `,${r.durationSec}\n`;
  });
  csvData = csv;
}

function exportCSV(){
  const blob = new Blob(["\ufeff"+csvData], {type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `qsort_matrix_${Date.now()}.csv`;
  a.click();
}
</script>
